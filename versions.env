# Pinned versions for host tools and cluster images. Change here, nowhere else.
# Each entry is verified (maintenance, licence, arm64) and recorded in docs/decisions.md before it lands here.
# In-cluster platform components are pinned in gitops/ (chart versions in each kustomization), also recorded in
# docs/decisions.md. CI tool pins in gitops/ci/versions.env must match the host tool pins below (unit-tested).
# v1 pins live at tag v1-frozen.

# Host tools, downloaded into .bin with checksum verification
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.36.5
HELM_VERSION=v4.3.1
KUSTOMIZE_VERSION=v5.8.3
KUBECONFORM_VERSION=v0.8.0
KYVERNO_VERSION=v1.19.1

# Images
K3S_IMAGE=rancher/k3s:v1.36.5-k3s1
K3D_PROXY_IMAGE=ghcr.io/k3d-io/k3d-proxy:5.9.0
K3D_TOOLS_IMAGE=ghcr.io/k3d-io/k3d-tools:5.9.0
REGISTRY_IMAGE=registry:3.1.2

# CLI runtime
PYTHON_VERSION=3.11
