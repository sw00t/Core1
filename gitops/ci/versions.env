# CI tool pins. Must match Core1's versions.env (Core1 unit tests check this).
KUSTOMIZE_VERSION=v5.8.3
KUBECONFORM_VERSION=v0.8.0
HELM_VERSION=v4.3.1
# Kubernetes version the clusters run (k3s v1.36.5+k3s1); kubeconform validates against it.
KUBERNETES_VERSION=v1.36.5
# datreeio/CRDs-catalog commit used for CRD schemas (2026-10-08).
CRDS_CATALOG_COMMIT=63669a570e231d4f1f8396d229a1de512bcf0a34
