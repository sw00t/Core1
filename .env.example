# Copy to .env and edit. .env is git-ignored. Never commit it.

# Fine-grained GitHub tokens, resource owner sw00t, repository core1-gitops only (required since phase 2).
#   argocd:     Contents read-only
#   automation: Contents, Pull requests, Workflows read and write; Actions, Commit statuses read-only
# `core1 up` copies them into OpenBao on every run, so a rotated token reaches the cluster.
#CORE1_GITHUB_TOKEN_ARGOCD=
#CORE1_GITHUB_TOKEN_AUTOMATION=
# GitOps repo (owner/name). Default: sw00t/core1-gitops
#CORE1_GITOPS_REPO=sw00t/core1-gitops

# Python 3.11 for the core1 CLI. Default: /opt/homebrew/bin/python3.11, then python3.11 on PATH.
#CORE1_PYTHON=/opt/homebrew/bin/python3.11

# Host ports, all on 127.0.0.1. The registry takes the base; mgmt, stage and prod take base+100, +200, +300
# (API x43, HTTP x80, HTTPS x81). Move the base if something else uses these ports.
#CORE1_PORT_BASE=17000

# Use binaries you already have instead of downloading (copied into .bin). For networks that block a download host.
#K3D_BIN=/opt/homebrew/bin/k3d
#KUBECTL_BIN=/opt/homebrew/bin/kubectl
#HELM_BIN=/opt/homebrew/bin/helm
