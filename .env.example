# Copy to .env and edit. Everything has a default; this file is optional.

# Host ports (bound to 127.0.0.1 only). Change if one is taken on your machine.
API_PORT=16443
GATEWAY_PORT=18080
ALERT_SINK_PORT=18081
PROM_PORT=19090
ALERTMANAGER_PORT=19093
LOKI_PORT=13100
GRAFANA_PORT=13000

# Cluster shape. Extra agent nodes cost memory; 0 is fine for the lab.
K3D_AGENTS=0

# Disk ceiling for everything this lab creates (repo + Docker images/volumes), in GB.
DISK_CEILING_GB=20
# Stop if the host volume has less than this many GB free.
HOST_FREE_MIN_GB=6

# Grafana admin password (lab only, local only).
GRAFANA_ADMIN_PASSWORD=core1-admin

# Where Alertmanager sends lab alerts. Default is the in-cluster sink.
# For an agent listening on your host: http://host.k3d.internal:PORT/path
ALERT_WEBHOOK_URL=http://alert-sink.core1-system.svc:8080/webhook

# Synthetic load, requests per second against the gateway.
LOAD_RPS=40

# Config repo location (the repo the agent will later work in).
CONFIG_REPO_DIR=.work/config-repo
